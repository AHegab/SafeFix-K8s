# ============================================================
# SafeFixK8s Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys
# IMPORTANT: Never commit .env to version control!
# ============================================================

# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# You only need to configure the providers you plan to use.
# SafeFixK8s will automatically fall back to available providers.
# At least one provider is required for the Repair stage.

# ============================================================
# OpenRouter Configuration
# ============================================================
# Supports multiple models including Grok, Claude, Gemini, etc.
# Get your API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=x-ai/grok-vision-beta

# Alternative OpenRouter models:
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-exp:free
# - meta-llama/llama-3.1-70b-instruct

# ============================================================
# Google Gemini Configuration
# ============================================================
# Get your API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# Alternative Gemini models:
# - gemini-1.5-pro
# - gemini-1.5-flash

# ============================================================
# Groq Configuration
# ============================================================
# Fast inference platform with free tier
# Get your API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Alternative Groq models:
# - llama-3.1-8b-instant (faster, less capable)
# - mixtral-8x7b-32768 (good for complex tasks)

# ============================================================
# OpenAI Configuration
# ============================================================
# Get your API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Alternative OpenAI models:
# - gpt-4o (highest quality, more expensive)
# - gpt-4-turbo (balanced quality and cost)

# ============================================================
# CONFIGURATION NOTES
# ============================================================
#
# Provider Recommendations:
# - For cost-effectiveness: Groq (free tier) or gpt-4o-mini
# - For quality: gpt-4o or claude-3.5-sonnet
# - For speed: Groq with llama-3.1-8b-instant
# - For reliability: Configure multiple providers for fallback
#
# Multi-Provider Setup (Recommended):
# Configure 2-3 providers for automatic fallback:
#   --models groq,gemini,openrouter
#
# Cost Optimization:
# Most fixes (60-70%) are deterministic and don't use LLM APIs.
# Template-based fixes use minimal tokens (~$0.001 per fix).
# LLM-guided fixes are used sparingly (~$0.01 per fix).
#
# ============================================================
