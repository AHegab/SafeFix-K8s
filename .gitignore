# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor  
#  Cursor is an AI-powered code editor.`.cursorignore` specifies files/directories to 
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore
/docker-bench-security
/images

# ============================================================================
# SafeFixK8s Specific Ignores
# ============================================================================

# Environment file with API keys (NEVER COMMIT!)
.env

# Scanner output files - raw results from security tools
detection/output/raw/*.json
detection/output/raw/*.txt
!detection/output/raw/.gitkeep

# Scanner logs
detection/output/logs/*.log
detection/output/logs/*.txt
!detection/output/logs/.gitkeep

# All results directories
results/
output/

# Normalized + pipeline outputs (reports/artifacts)
output/normalized_findings.json
output/llm_payload.json
output/detection_effectiveness_report.json
output/stage_deltas.json
output/patch_validation_report.json
output/llm/patch_sandbox/**
output/llm/llm_decisions.json
output/combination/SECURED_*
output/combination/INEFFECTIVE_*
output/combination/INVALID_*
output/combination/MANUAL_REQUIRED_*
output/combination/DECISIONS_*.json
output/combination/VALIDATION_*.json
!output/.gitkeep

# Temporary files
temp_show.py
*.tmp
*.temp

# Tool-specific outputs
detection/results.json
detection/kubescape_*.json
detection/kubeaudit_*.json

# Test outputs and reports
tests/reports/*.html
tests/reports/*.json
tests/reports/*.xml
tests/test_output.json

# Docker images cache
detection/images/*
!detection/images/.gitkeep

# PowerShell debug/transcript files
*.ps1.log
Transcript-*.txt

